# --- LLM ---
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_DEV=
LLM_MODEL_EVAL=
LLM_TIMEOUT_S=60
# 단가는 OpenAI가 수시로 바꾼다 — 값을 추측해서 채우지 않는다. OpenAI 요금
# 페이지의 1M(백만 토큰당) 단가를 그대로 입력. 미설정 시 비용은 0으로 기록됨.
LLM_PRICE_INPUT_PER_1M=0
LLM_PRICE_OUTPUT_PER_1M=0
AGENT_MAX_STEPS=6

# --- 임베딩·리랭커 (TEI) ---
EMBED_BASE_URL=http://localhost:8080
RERANK_BASE_URL=http://localhost:8081
TEI_API_KEY=
EMBED_MODEL_ID=nlpai-lab/KURE-v1        # 기본값 — 이슈 #16 실험 결과로 변경될 수 있음
RERANK_MODEL_ID=BAAI/bge-reranker-v2-m3 # 기본값 — 이슈 #16 실험 결과로 변경될 수 있음
EMBED_TIMEOUT_S=30
RERANK_TIMEOUT_S=30

# --- 비용 로그 ---
COST_LOG_PATH=data/cost_log.jsonl

# --- 저장소 ---
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_ALIAS=rfp_chunks
POSTGRES_DSN=postgresql+psycopg://app:app@localhost:5432/si
POSTGRES_READONLY_DSN=postgresql+psycopg://agent_ro:agent_ro@localhost:5432/si

# --- docker-compose (postgres 컨테이너 초기화용 — 위 DSN들과 계정/DB명 일치 필요) ---
POSTGRES_DB=si
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_READONLY_USER=agent_ro
POSTGRES_READONLY_PASSWORD=agent_ro

# --- 나라장터 (공공데이터포털 조달청 입찰공고정보서비스) ---
# 포털의 마이페이지에는 인증키가 "일반 인증키(Encoding)"와 "일반 인증키
# (Decoding)" 두 가지로 제공된다. 여기에는 반드시 Decoding 값(%2B 등 URL
# 인코딩이 풀린 형태, 예: %2B → +)을 넣을 것. Encoding 값을 그대로 넣으면
# httpx가 요청 시 '%'를 다시 인코딩(%→%25)해 이중 인코딩이 되고 403이 난다.
NARA_API_KEY=
NARA_BASE_URL=https://apis.data.go.kr/1230000/ad/BidPublicInfoService
NARA_TIMEOUT_S=30

# --- 데이터 ---
AS_OF_DATE=2026-09-21
SYNTH_SEED=42
