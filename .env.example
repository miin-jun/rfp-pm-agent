# --- LLM ---
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_DEV=
LLM_MODEL_EVAL=
LLM_TIMEOUT_S=60
# 단가는 OpenAI가 수시로 바꾼다 — 값을 추측해서 채우지 않는다. OpenAI 요금
# 페이지의 1M(백만 토큰당) 단가를 그대로 입력. 미설정 시 비용은 0으로 기록됨.
LLM_PRICE_INPUT_PER_1M=0
LLM_PRICE_OUTPUT_PER_1M=0
AGENT_MAX_STEPS=6

# --- 임베딩·리랭커 (TEI) ---
EMBED_BASE_URL=http://localhost:8080
RERANK_BASE_URL=http://localhost:8081
TEI_API_KEY=
# 두 모델 ID는 TEI 서버(docker-compose.yml)와 클라이언트(config.py)가 함께 읽는다.
# 바꾼 뒤 `docker compose up -d tei-embed` 등으로 컨테이너를 다시 만들면 교체된다.
# 기본값 — 이슈 #16 실험 결과로 변경될 수 있음
EMBED_MODEL_ID=nlpai-lab/KURE-v1
# 기본값 — 이슈 #16 실험 결과로 변경될 수 있음
RERANK_MODEL_ID=BAAI/bge-reranker-v2-m3
EMBED_TIMEOUT_S=30
RERANK_TIMEOUT_S=30
# 임베딩 입력 접두어. 끝의 공백까지 값이므로 따옴표로 감싼다. KURE-v1·bge-m3는 비워 두고,
# multilingual-e5는 EMBED_QUERY_PREFIX="query: " / EMBED_PASSAGE_PREFIX="passage: " (모델 카드)
EMBED_QUERY_PREFIX=
EMBED_PASSAGE_PREFIX=
# 모델 최대 길이를 넘는 입력을 잘라 임베딩할지(true/false). 기본 false면 서버가 413으로 거절한다.
# #16에서 e5(최대 512토큰)만 true — 자른 입력 수는 run_retrieval 실행 기록에 남는다
EMBED_TRUNCATE=false
# TEI 요청 1건의 최대 입력 수. 서버(docker-compose.yml의 MAX_CLIENT_BATCH_SIZE)와
# 클라이언트(config.py, 이 크기씩 나눠 보냄)가 함께 읽는다. 바꾸면 컨테이너를 다시 만든다
TEI_MAX_CLIENT_BATCH_SIZE=32
# TEI 토크나이저 워커 수(docker-compose.yml에서만 읽음). 원인 분리 실험(AUTO_TRUNCATE 고정)에서
# 임베딩 서버 VmRSS가 미지정(워커 19개, nproc=20) 5.09GB, 2개 1.29GB (docs/learning-log.md 2026-09-24)
TEI_TOKENIZATION_WORKERS=2
# TEI 모델 파일이 있는 Docker 볼륨(compose 프로젝트 이름_tei_models). run_retrieval이 여기서
# 모델 스냅샷 해시를 읽어 revision으로 기록한다 (/info의 model_sha가 null이라서)
TEI_MODELS_VOLUME=rfp-pm-agent_tei_models

# --- 비용 로그 ---
COST_LOG_PATH=data/cost_log.jsonl

# --- 저장소 ---
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_ALIAS=rfp_chunks
# 색인 모듈이 쓰는 실제 인덱스(모델별). 검색 코드는 위 별칭만 쓴다 (docs/data-design.md 5절)
OPENSEARCH_INDEX_NAME=rfp_chunks_v2_kure
POSTGRES_DSN=postgresql+psycopg://app:app@localhost:5432/si
POSTGRES_READONLY_DSN=postgresql+psycopg://agent_ro:agent_ro@localhost:5432/si

# --- docker-compose (postgres 컨테이너 초기화용 — 위 DSN들과 계정/DB명 일치 필요) ---
POSTGRES_DB=si
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_READONLY_USER=agent_ro
POSTGRES_READONLY_PASSWORD=agent_ro

# --- 나라장터 (공공데이터포털 조달청 입찰공고정보서비스) ---
# 포털의 마이페이지에는 인증키가 "일반 인증키(Encoding)"와 "일반 인증키
# (Decoding)" 두 가지로 제공된다. 여기에는 반드시 Decoding 값(%2B 등 URL
# 인코딩이 풀린 형태, 예: %2B → +)을 넣을 것. Encoding 값을 그대로 넣으면
# httpx가 요청 시 '%'를 다시 인코딩(%→%25)해 이중 인코딩이 되고 403이 난다.
NARA_API_KEY=
NARA_BASE_URL=https://apis.data.go.kr/1230000/ad/BidPublicInfoService
NARA_TIMEOUT_S=30

# --- 데이터 ---
AS_OF_DATE=2026-09-21
SYNTH_SEED=42
