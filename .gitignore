# secrets
.env
.env.local

# data (raw/parsed/chunked artifacts, RFP originals — never committed)
# manifest.jsonl은 예외: 원본은 안 올리지만 "무엇을 어디서 받았는지"는 레포에 남긴다
data/*
!data/raw/
data/raw/*
!data/raw/manifest.jsonl
# eval/은 예외: 평가 질문 세트는 사람이 검수한 데이터라 레포에 남긴다
!data/eval/
# 예외의 예외: RTM 리랭커 점수표(#39, 1.2MB)는 pre-commit 큰 파일 검사(500KB)에 걸려 넣지 않는다.
# sha256과 다시 만드는 명령은 docs/adr/0012-rtm-reranker-mapping.md 결정 1
data/eval/rtm_scores_v*.csv
# synth/wbs_drafts/는 예외: 합성 PMS의 LLM 초안(#20). 정답(data/eval/pms_truth_v1·v2.json)을 프롬프트 버전 폴더별로 LLM 없이 다시 만드는 입력이다.
# 생성 결과(pms_v*.json)는 초안 + seed로 다시 만들 수 있어 올리지 않는다
!data/synth/
data/synth/*
!data/synth/wbs_drafts/

# claude code local state
.claude/logs/
.claude/settings.local.json

# python
.venv/
__pycache__/
*.pyc

# uv
.python-version.local
